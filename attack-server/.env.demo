# .env.development
ENVIRONMENT=dev
DEBUG=true

# Repository Paths
MODEL_REPO=models_repo_ntp304
DATASETS_REPO=datasets_repo

# Application Configuration
LOG_LEVEL=info
HOST=0.0.0.0
PORT=8082
WORKERS=1
TIMM_MODELS_JSON_PATH="resources/timm_models.json"
MAX_MODEL_SIZE_UPLOAD=5000
MAX_MODEL_JSON_SIZE_UPLOAD=5000

# Ray Cluster Configuration
RAY_HEAD_HOST=127.0.0.1
RAY_HEAD_PORT=6379
RAY_DASHBOARD_PORT=8265
RAY_NUM_ACTORS=2
FRACTION_FOR_GPU_ACTOR=0.5
RAY_PY_MODULES=./benchmarking
# RAY_HEAD_ADDRESS=192.168.1.100:6379  # Uncomment and set for worker nodes

BENCHMARK_LOAD_RESULTS=False
BENCHMARK_OVERWRITE=True
BENCHMARK_NUM_IMAGES_TO_SAVE=-1
BENCHMARK_SAVE_PERTURBATION=False
BENCHMARK_GPU=True
BENCHMARK_OUTPUT_DIR=./benchmark_out
BENCHMARK_OUTPUT_FORMAT=report

INFER_PORT=8080
INFER_HOST=0.0.0.0