# .env.development
ENVIRONMENT=dev
DEBUG=true

# Redis Configuration
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
DB_NUMBER=0

# Celery Configuration
CELERY_APP=celery_worker.celery
CELERY_WORKDIR=./celery_src
CELERY_LOG_LEVEL=info
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Flower Configuration
FLOWER_PORT=5555

# GUI Development Server
GUI_DEV_PORT=3000

# Repository Paths
MODEL_REPO=models_repo
DATASETS_REPO=datasets_repo

# Application Configuration
LOG_LEVEL=info
HOST=0.0.0.0
PORT=8000
WORKERS=1

TIMM_MODELS_JSON_PATH="resources/timm_models.json"
MAX_MODEL_SIZE_UPLOAD=5000